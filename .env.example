# RefStats ortam değişkenleri
# Bu dosyayı server/.env olarak kopyalayın:  cp .env.example server/.env
# Gerçek parolaları ve gizli anahtarları ASLA commit etmeyin.

# --- Veritabanı (PostgreSQL) ---
# docker-compose.yml ile gelen yerel veritabanı için aşağıdaki değer doğrudan çalışır.
DATABASE_URL="postgresql://refstats:refstats_dev_password@localhost:5432/refstats?schema=public"
# Otomatik testlerin kullandığı ayrı veritabanı (testler bu veritabanını SIFIRLAR).
TEST_DATABASE_URL="postgresql://refstats:refstats_dev_password@localhost:5432/refstats_test?schema=public"

# --- Sunucu ---
NODE_ENV=development
PORT=4000
# Uygulamanın kullanıcılara görünen adresi (şifre sıfırlama bağlantılarında kullanılır).
APP_URL=http://localhost:5173
# Oturum çerezlerinin süresi (gün)
SESSION_TTL_DAYS=30
# Profil fotoğraflarının kaydedileceği klasör (server klasörüne göre)
UPLOAD_DIR=uploads

# --- E-posta (şifre sıfırlama) ---
# SMTP ayarlanmazsa e-posta gönderilmez. Geliştirmede MAIL_DEV_LOG=true ise
# sıfırlama bağlantısı yalnızca sunucu konsoluna yazılır (production'da asla).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RefStats <no-reply@example.com>"
MAIL_DEV_LOG=true

# --- İlk yönetici hesabı (npm run db:seed) ---
# Boş bırakılırsa yönetici oluşturulmaz; sonradan `npm run create-admin -- <e-posta>` kullanılabilir.
ADMIN_EMAIL=
ADMIN_PASSWORD=
